# Private AI Circuit — Configuration
# Copy this file: cp terraform.tfvars.example terraform.tfvars
# Then fill in your values below.

# ── Required ──────────────────────────────────────────────────────────────────

# Your current public IP (restricts SSH and Hermes access)
# Find it: curl ifconfig.me
my_ip = "0.0.0.0"   # ← CHANGE THIS before terraform apply

# Project name — prefix for all AWS resource names
client_name = "private-ai"

# Path to your SSH public key
# Linux/Mac: ssh-keygen -t ed25519 -f ~/.ssh/hermes-ai-key
# Windows:   ssh-keygen -t ed25519 -f $env:USERPROFILE\.ssh\hermes-ai-key
ssh_public_key_path = "~/.ssh/hermes-ai-key.pub"
# Windows example:
# ssh_public_key_path = "C:/Users/YourName/.ssh/hermes-ai-key.pub"

# ── Instance ──────────────────────────────────────────────────────────────────

# g4dn.xlarge  — T4 16GB,  ~$0.53/hr  ← recommended
# g5.xlarge    — A10G 24GB, ~$1.01/hr
# g5.4xlarge   — A10G 24GB, ~$1.62/hr
instance_type = "g4dn.xlarge"

# 80GB  — fits 2–3 models (7B–14B)
# 120GB — fits 4–5 models
volume_size_gb = 80

# ── Region ────────────────────────────────────────────────────────────────────

# eu-central-1  — Frankfurt
# eu-west-1     — Ireland
# us-east-1     — N. Virginia (cheapest GPU spot prices)
region = "eu-central-1"

# ── Auto-stop ─────────────────────────────────────────────────────────────────

auto_stop_enabled = true
low_cpu_threshold = 8
idle_minutes      = 25
